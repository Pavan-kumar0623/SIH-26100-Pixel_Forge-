# ProcureAI Backend Configuration

# Gemini API Key (for document classification, data extraction, cross-document checks)
GEMINI_PROCUREMENT_API_KEY=
# Fallback alias for Gemini API key
GEMINI_API_KEY=

# Grok / xAI API Configuration (for conversational procurement officer assistant)
XAI_API_KEY=
GROK_MODEL=openai/gpt-oss-120b
GROK_API_BASE_URL=https://api.groq.com/openai/v1

# Tesseract OCR path (optional - auto-detected if left empty)
# Examples:
# Windows: C:\Program Files\Tesseract-OCR\tesseract.exe
# Linux/macOS: /usr/bin/tesseract
TESSERACT_CMD=

# Database Configuration
DATABASE_URL=sqlite:///./procure_ai.db

# File Storage Configuration
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=50
